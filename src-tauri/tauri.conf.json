{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dosik",
  "version": "0.2.0",
  "identifier": "app.dosik.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:mcp",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dosik",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Diagrams you draw — and agents can edit",
    "longDescription": "A modern diagram app: flowcharts, sequence, class and ER diagrams, exported to Markdown (Mermaid), PNG and SVG. A local bridge lets AI agents read and edit the canvas.",
    "copyright": "© 2026 Dosik",
    "publisher": "Dosik",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "mcp/": "mcp/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
